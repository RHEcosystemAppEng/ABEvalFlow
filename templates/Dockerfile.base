# Eval base image for classic Harbor A/B (and A2A) pipeline steps.
#
# Installs stock Harbor from PyPI (not skills_eval_corrections) plus AEH
# KubernetesEnvironment so ABEvalFlow's OpenShift custom env can be imported:
#   abevalflow.harbor_extensions.openshift_environment:OpenShiftEnvironment
#
# Build from repo root (COPY abevalflow + AEH clone need full context):
#   ./scripts/build_base_image.sh
#   # or:
#   podman build -f templates/Dockerfile.base \
#     --build-arg AEH_SHA=ff8b8301d861d2cc83a46ec12c394aafb846171b \
#     -t eval-base:latest .

FROM registry.access.redhat.com/ubi9/python-312:latest

ARG INSTALL_CLAUDE_CODE=false
ARG AEH_REPO=https://github.com/opendatahub-io/agent-eval-harness.git
# Pin to AEH v1.20.0 (matches agent-eval-harness:v1.0.3 image contents).
ARG AEH_SHA=ff8b8301d861d2cc83a46ec12c394aafb846171b
ARG HARBOR_VERSION=0.20.0

USER 0

RUN dnf install -y git tar && dnf clean all
RUN curl -LsSf https://astral.sh/uv/0.9.7/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh
RUN mkdir -p /installed-agent && chmod 777 /installed-agent
RUN if [ "$INSTALL_CLAUDE_CODE" = "true" ]; then npm install -g @anthropic-ai/claude-code; fi
RUN mkdir -p /workspace && chown 1001:0 /workspace && chmod 775 /workspace

# Validate AEH_SHA — must be a 7-40 char hex commit SHA
RUN if ! echo "${AEH_SHA}" | grep -qE '^[0-9a-fA-F]{7,40}$'; then \
      echo "ERROR: AEH_SHA must be a 7-40 char hex commit SHA, got '${AEH_SHA}'" >&2; \
      exit 1; \
    fi

# Clone agent-eval-harness at pinned SHA (provides KubernetesEnvironment)
RUN git init /opt/agent-eval-harness \
    && cd /opt/agent-eval-harness \
    && git remote add origin ${AEH_REPO} \
    && git fetch origin main \
    && git checkout ${AEH_SHA} \
    && rm -rf .git

# Bake abevalflow for OpenShift custom env (also overlaid via PYTHONPATH in Tekton)
COPY --chown=1001:0 abevalflow /opt/agent-eval-harness/abevalflow

# Stock Harbor from PyPI — no skills_eval_corrections fork
RUN pip install --no-cache-dir \
    "harbor==${HARBOR_VERSION}" \
    "kubernetes>=32.0.0" \
    pydantic \
    pyyaml \
    "tomlkit>=0.13"

ENV PYTHONPATH=/opt/agent-eval-harness \
    HOME=/workspace

RUN mkdir -p /logs /tests /solution \
    && chgrp -R 0 /workspace /logs /tests /solution /opt/agent-eval-harness \
    && chmod -R g=u /workspace /logs /tests /solution /opt/agent-eval-harness

USER 1001

WORKDIR /workspace
